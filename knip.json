{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreExportsUsedInFile": true,
  "ignore": ["tools/preflight-native-bindings.d.mts"],
  "ignoreDependencies": ["@arethetypeswrong/cli", "publint", "madge", "tsx", "jscpd"],
  "ignoreBinaries": ["turbo"],
  "tags": ["-knipignore"],
  "workspaces": {
    ".": {
      "entry": ["e2e/**/*.e2e.test.ts", "tools/*.mjs"],
      "project": ["e2e/**/*.ts", "tools/**/*.mjs"]
    },
    "packages/sdk": {
      "entry": ["src/agent.ts", "tests/**/*.test.ts", "tests/helpers/**/*.ts", "bin/*.mjs"],
      "project": ["src/**/*.ts", "tests/**/*.ts"],
      "ignore": ["src/stream-object.ts"],
      "ignoreDependencies": ["jsonrepair"]
    },
    "packages/cli": {
      "entry": ["tests/**/*.test.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    }
  }
}
