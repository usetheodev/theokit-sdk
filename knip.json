{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreExportsUsedInFile": true,
  "ignore": ["tools/preflight-native-bindings.d.mts"],
  "ignoreDependencies": ["@arethetypeswrong/cli", "publint", "madge", "tsx", "jscpd"],
  "ignoreBinaries": ["turbo"],
  "tags": ["-knipignore"],
  "workspaces": {
    "packages/sdk": {
      "entry": ["src/agent.ts", "tests/**/*.test.ts", "tests/helpers/**/*.ts", "bin/*.mjs"],
      "project": ["src/**/*.ts", "tests/**/*.ts"],
      "ignore": [
        "src/internal/memory/sqlite-vec-loader.ts",
        "src/internal/memory/storage/markdown-store.ts",
        "src/internal/memory/types.ts",
        "src/internal/runtime/tools/hitl-middleware.ts",
        "src/internal/telemetry/span-names.ts",
        "src/stream-object.ts"
      ],
      "ignoreDependencies": ["jsonrepair"]
    },
    "packages/cli": {
      "entry": ["tests/**/*.test.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    }
  }
}
