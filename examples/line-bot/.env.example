# OpenRouter / OpenAI / Anthropic key.
OPENROUTER_API_KEY=sk-or-v1-...

# LINE Developers Console → Messaging API channel.
LINE_CHANNEL_SECRET=...
LINE_CHANNEL_ACCESS_TOKEN=...

# Bot's own LINE user id — used by the mention guard in group chats.
LINE_BOT_USER_ID=Uxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Public webhook URL — use ngrok in dev.
PUBLIC_URL=https://abc.ngrok.io

# Webhook listen port.
PORT=3000

# For smoke.ts: target userId for a one-shot push test.
LINE_TEST_USER_ID=Uyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy
