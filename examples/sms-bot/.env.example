# OpenRouter API key for the agent (or use OPENAI_API_KEY / ANTHROPIC_API_KEY).
OPENROUTER_API_KEY=sk-or-v1-...

# Twilio credentials — get these from console.twilio.com.
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_FROM=+1...           # Your Twilio phone number, E.164 format
TWILIO_TO=+55...            # Recipient (for smoke.ts only)

# Public URL where Twilio will POST inbound messages.
# Locally, use `ngrok http 3000` and paste the https URL here.
PUBLIC_URL=https://abc.ngrok.io

# Inbound webhook listen port (default 3000).
PORT=3000
