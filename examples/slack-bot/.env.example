# Slack Bot User OAuth Token (xoxb-...) — from "OAuth & Permissions" page of your app.
SLACK_BOT_TOKEN=xoxb-...

# Slack App-Level Token (xapp-...) with connections:write scope — from "Basic Information" > "App-Level Tokens".
SLACK_APP_TOKEN=xapp-...

# OpenRouter for the LLM behind the demo replies.
OPENROUTER_API_KEY=sk-or-...
