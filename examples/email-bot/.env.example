# --- Email account credentials ---
# Gmail users: generate an App Password at https://myaccount.google.com/apppasswords
# (NOT your account password — those don't work with IMAP/SMTP since 2022.)
EMAIL_ADDRESS=bot@example.com
EMAIL_PASSWORD=your_app_password_here

# --- IMAP (inbound) ---
# Gmail:    imap.gmail.com / 993
# Outlook:  outlook.office365.com / 993
# Yahoo:    imap.mail.yahoo.com / 993
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_PORT=993

# --- SMTP (outbound) ---
# Gmail:    smtp.gmail.com / 587 (STARTTLS) or 465 (TLS)
# Outlook:  smtp.office365.com / 587
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587

# --- Optional behavior ---
# Display name for outbound From: header.
EMAIL_FROM_NAME=Theo

# Comma-separated allowlist of senders. Empty/unset = open (no allowlist).
# EC-3: bracketed or pure-address entries both work.
EMAIL_ALLOWED_SENDERS=

# Poll interval in ms when IMAP IDLE is unavailable (default 15000).
# EMAIL_POLL_INTERVAL_MS=15000

# --- LLM provider ---
# Any provider supported by the SDK works. OpenRouter is the simplest.
OPENROUTER_API_KEY=sk-or-v1-...
