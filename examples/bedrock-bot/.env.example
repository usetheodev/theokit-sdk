# AWS Bedrock Bearer token (GA Sep 2025). Generate in AWS Console:
#   IAM → Users → <your-user> → Security credentials → Bedrock API keys
# Or via CLI:
#   aws iam create-service-specific-credential --service-name bedrock.amazonaws.com
AWS_BEARER_TOKEN_BEDROCK=

# AWS region for Bedrock endpoint. Optional — model id prefix (us./eu./apac./jp./global.)
# takes precedence.
AWS_REGION=us-east-1

# Optional: pin a specific model. Default: us.anthropic.claude-sonnet-4-5-v1:0
# BEDROCK_MODEL=us.anthropic.claude-sonnet-4-5-v1:0
