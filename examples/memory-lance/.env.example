# Copy this file to `.env` and fill in the secrets to enable real-LLM mode.
# Without these, `pnpm run` runs in dry-run mode (no LLM, no Lance writes).

# Required ONLY for real mode (LANCE_REAL=1):
OPENROUTER_API_KEY=

# Toggle real mode. When unset/0, the script prints what WOULD happen and exits.
# When 1, the script:
#   1. Verifies `@lancedb/lancedb` is installed (else prints actionable install hint)
#   2. Opens a Lance-backed Memory index in a tmpdir
#   3. Adds 3 synthetic facts with real OpenRouter embeddings (cheap model)
#   4. Runs `agent.send()` with active recall ON
#   5. Asserts the assistant reply references at least one fact
LANCE_REAL=
