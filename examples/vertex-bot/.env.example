# GCP Vertex AI requires Application Default Credentials (ADC).
# Easiest: run `gcloud auth application-default login` once. No env var needed.
#
# Production (service account JSON file):
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/sa-key.json

# GCP project id (required).
GOOGLE_CLOUD_PROJECT=my-gcp-project

# Vertex location/region. "global" for cross-region routing (Anthropic).
# Default: us-central1.
GOOGLE_CLOUD_LOCATION=us-central1

# Optional: pin a specific model. Default: vertex/google/gemini-2.0-flash-001
# Anthropic example: vertex/anthropic/claude-sonnet-4-5@20250929
# VERTEX_MODEL=vertex/google/gemini-2.0-flash-001
