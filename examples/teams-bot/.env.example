# Azure AD application registered as a Bot Framework bot
TEAMS_CLIENT_ID=
TEAMS_CLIENT_SECRET=
TEAMS_TENANT_ID=

# Bot display name (used as fallback for mention stripping)
TEAMS_BOT_DISPLAY_NAME=Theo

# Provider key for the agent
OPENROUTER_API_KEY=

# Local server port (Azure Bot Service default: 3978)
PORT=3978
