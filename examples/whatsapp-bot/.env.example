# Meta WhatsApp Business Cloud API credentials
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=

# Webhook verification token — match what you set in Meta Developer Console.
WHATSAPP_VERIFY_TOKEN=any-random-string-you-pick

# Agent provider
OPENROUTER_API_KEY=

# Local server port
PORT=3000

# OPTIONAL for smoke test — pre-registered phone number in Meta Console.
WHATSAPP_TEST_PHONE=
