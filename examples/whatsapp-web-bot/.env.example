# Provider key (the agent the bot uses internally)
OPENROUTER_API_KEY=

# Session id — locks the bridge subprocess per workspace.
# Use the same value across restarts to reuse the WhatsApp Web login.
WHATSAPP_SESSION_ID=my-bot

# Your bot's phone (digits only — what WhatsApp shows for your account, without +).
# Used to filter group mentions. Optional — set to enable group conversations.
WHATSAPP_BOT_PHONE=
