# --- LLM provider ---
# Required for the agent to call MCP tools. Any provider supported by the SDK works.
OPENROUTER_API_KEY=sk-or-v1-...

# --- Google Workspace credentials ---
# After running `theokit setup gworkspace`, this is auto-populated by the
# upstream `google-workspace-mcp` server at ~/.google-mcp/credentials.json.
# Recipes use this only as a sentinel to decide whether to skip.
GOOGLE_APPLICATION_CREDENTIALS=/home/youruser/.google-mcp/credentials.json

# --- Optional ---
# Named account if you set one up via `npx google-workspace-mcp accounts add <name>`.
# Default: unset (uses "default" account).
# GOOGLE_WORKSPACE_ACCOUNT=work
