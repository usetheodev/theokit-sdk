{
  "name": "theokit-sdk-monorepo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=9.15.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "npx turbo run build --filter='./packages/*'",
    "test": "npx turbo run test --filter='./packages/*'",
    "test:watch": "pnpm --filter=./packages/* run test:watch",
    "test:roadmap": "pnpm --filter=@theokit/sdk exec vitest run --config vitest.roadmap.config.ts",
    "eval": "pnpm --filter=@theokit/sdk run eval",
    "typecheck": "npx turbo run typecheck --filter='./packages/*'",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "validate:publint": "pnpm --filter=@theokit/sdk exec publint",
    "validate:attw": "pnpm --filter=@theokit/sdk exec attw --pack . --ignore-rules no-resolution",
    "validate:naming": "ls-lint",
    "quality:dead": "knip",
    "quality:cycles": "node tools/check-cycles.mjs",
    "quality:depcruise": "depcruise --config .dependency-cruiser.cjs packages/sdk/src",
    "quality:loc": "node tools/check-loc.mjs",
    "quality:duplication": "jscpd packages/sdk/src",
    "quality:coverage": "pnpm --filter=@theokit/sdk exec vitest run --coverage",
    "quality:audit": "pnpm audit --prod --audit-level=high || echo '(quality:audit: high-severity advisories found — review and triage)'",
    "quality:cross-cluster": "node tools/check-cross-cluster.mjs",
    "examples:workspace": "node tools/examples-workspace/server.mjs",
    "examples:workspace:test": "node --test tools/examples-workspace/lib.test.mjs",
    "quality": "pnpm run quality:dead && pnpm run quality:dead-internal && pnpm run quality:cycles && pnpm run quality:depcruise && pnpm run quality:cross-cluster && pnpm run quality:loc && pnpm run quality:duplication",
    "quality:report": "pnpm run quality && pnpm run quality:coverage && pnpm run quality:audit",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "validate": "pnpm run check && npx turbo run build typecheck test --filter='./packages/*' && pnpm run validate:naming && pnpm run validate:publint && pnpm run validate:attw && pnpm run quality && pnpm run check:bundle",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "start": "pnpm run build",
    "release": "pnpm run build && changeset publish",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "quality:dead-internal": "node tools/check-internal-deadcode.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@biomejs/biome": "^2.4.0",
    "@changesets/cli": "^2.31.0",
    "@ls-lint/ls-lint": "2.3.1",
    "@types/jscodeshift": "^17.3.0",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^4.1.8",
    "dependency-cruiser": "^16.10.0",
    "jscodeshift": "^17.3.0",
    "jscpd": "^4.0.5",
    "knip": "^5.39.0",
    "madge": "8.0.0",
    "publint": "^0.3.20",
    "tsup": "^8.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.8"
  },
  "pnpm": {
    "overrides": {
      "zod": "^4.0.0"
    }
  }
}
