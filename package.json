{
  "name": "theokit-sdk-monorepo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=9.15.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "npx turbo run build --filter='./packages/*'",
    "test": "npx turbo run test --filter='./packages/*'",
    "test:watch": "pnpm --filter=./packages/* run test:watch",
    "test:roadmap": "pnpm --filter=@theokit/sdk exec vitest run --config vitest.roadmap.config.ts",
    "typecheck": "npx turbo run typecheck --filter='./packages/*'",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "validate:publint": "pnpm --filter=@theokit/sdk exec publint",
    "validate:attw": "pnpm --filter=@theokit/sdk exec attw --pack . --ignore-rules no-resolution",
    "validate:naming": "ls-lint",
    "quality:dead": "knip",
    "quality:cycles": "node tools/check-cycles.mjs",
    "quality:depcruise": "depcruise --config .dependency-cruiser.cjs packages/sdk/src",
    "quality:loc": "node tools/check-loc.mjs",
    "quality:duplication": "jscpd packages/sdk/src",
    "quality:coverage": "pnpm --filter=@theokit/sdk exec vitest run --coverage",
    "quality:audit": "pnpm audit --prod --audit-level=high || echo '(quality:audit: high-severity advisories found — review and triage)'",
    "quality": "pnpm run quality:dead && pnpm run quality:cycles && pnpm run quality:depcruise && pnpm run quality:loc && pnpm run quality:duplication",
    "quality:report": "pnpm run quality && pnpm run quality:coverage && pnpm run quality:audit",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "validate:sdk-2-0": "node scripts/validate-sdk-2-0.mjs",
    "validate:sdk-2-0:bail": "node scripts/validate-sdk-2-0.mjs --bail",
    "sdk-2-0:runbook-check": "node scripts/__tests__/runbook-commands-resolvable.test.mjs",
    "sdk-2-0:migration-check": "node scripts/__tests__/migration-guide-coverage.test.mjs",
    "sdk-2-0:changelog-check": "node scripts/__tests__/cohort-changelog-shape.test.mjs",
    "sdk-2-0:status": "node scripts/sdk-2-0-status.mjs",
    "sdk-2-0:status:json": "node scripts/sdk-2-0-status.mjs --json",
    "sdk-2-0:drift": "node scripts/sdk-2-0-stage3-drift-detector.mjs",
    "sdk-2-0:pre-publish": "node scripts/sdk-2-0-pre-publish-check.mjs",
    "sdk-2-0:post-publish:dry": "node scripts/sdk-2-0-post-publish-check.mjs --dry",
    "sdk-2-0:cohort:analyze": "node scripts/phase7-cohort-analysis.mjs",
    "sdk-2-0:cohort:readiness": "node scripts/__tests__/sdk-2-0-cohort-publish-readiness.test.mjs",
    "sdk-2-0:phase6:dry": "node scripts/phase6-rename-dry-run.mjs",
    "sdk-2-0:phase7:peerdep-bump:dry": "node scripts/phase7-peerdep-bump.mjs --dry",
    "validate": "pnpm run check && npx turbo run build typecheck test --filter='./packages/*' && pnpm run validate:naming && pnpm run validate:publint && pnpm run validate:attw && pnpm run quality && pnpm run check:bundle",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "start": "pnpm run build",
    "release": "pnpm run build && changeset publish",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@biomejs/biome": "^2.4.0",
    "@changesets/cli": "^2.31.0",
    "@ls-lint/ls-lint": "2.3.1",
    "@types/jscodeshift": "^17.3.0",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^4.1.8",
    "dependency-cruiser": "^16.10.0",
    "jscodeshift": "^17.3.0",
    "jscpd": "^4.0.5",
    "knip": "^5.39.0",
    "madge": "8.0.0",
    "publint": "^0.3.20",
    "tsup": "^8.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.8"
  },
  "pnpm": {
    "overrides": {
      "zod": "^4.0.0"
    }
  }
}
