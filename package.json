{
  "name": "theokit-sdk-monorepo",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=9.15.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "npx turbo run build --filter='./packages/*'",
    "test": "npx turbo run test --filter='./packages/*'",
    "test:watch": "pnpm --filter=./packages/* run test:watch",
    "test:roadmap": "pnpm --filter=@theokit/sdk exec vitest run --config vitest.roadmap.config.ts",
    "test:order-shuffle": "pnpm --filter=@theokit/sdk exec vitest run --config vitest.shuffle.config.ts",
    "eval": "pnpm --filter=@theokit/sdk run eval",
    "typecheck": "npx turbo run typecheck --filter='./packages/*'",
    "check": "git ls-files -z | xargs -0 biome check && pnpm run check:sdk-subentries",
    "check:sdk-subentries": "node packages/sdk/scripts/check-subentry-consistency.mjs",
    "check:fix": "biome check --write .",
    "validate:publint": "pnpm --filter=@theokit/sdk exec publint",
    "validate:attw": "pnpm --filter=@theokit/sdk exec attw --pack . --ignore-rules no-resolution",
    "validate:naming": "ls-lint",
    "quality:dead": "knip && node tools/report-dead-code-scope.mjs",
    "quality:cycles": "node tools/check-cycles.mjs",
    "quality:depcruise": "depcruise --config .dependency-cruiser.cjs packages/sdk/src packages/sdk/tests",
    "quality:loc": "node tools/check-loc.mjs",
    "quality:duplication": "node tools/check-duplication.mjs",
    "quality:coverage": "pnpm --filter=@theokit/sdk exec vitest run --coverage",
    "quality:audit": "pnpm audit --prod --audit-level=low && pnpm audit --audit-level=high",
    "quality:cross-cluster": "node tools/check-cross-cluster.mjs",
    "quality:dts-exports": "node tools/check-dts-exports.mjs",
    "quality": "pnpm run quality:dead && pnpm run quality:dead-internal && pnpm run quality:cycles && pnpm run quality:depcruise && pnpm run quality:cross-cluster && pnpm run quality:loc && pnpm run quality:duplication && pnpm run quality:dts-exports && pnpm run quality:dts-typechecks && pnpm run quality:audit",
    "quality:report": "pnpm run quality && pnpm run quality:coverage && pnpm run quality:audit",
    "check:bundle": "node tools/check-bundle-budget.mjs",
    "validate": "pnpm run check && npx turbo run build typecheck test --filter='./packages/*' && pnpm run validate:naming && pnpm run validate:publint && pnpm run validate:attw && pnpm run quality && pnpm run check:bundle",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "start": "pnpm run build",
    "release": "pnpm run build && node tools/check-publish-no-workspace.mjs && changeset publish",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "quality:dead-internal": "node tools/check-internal-deadcode.mjs",
    "verify:refs": "node tools/verify-release-refs.mjs",
    "quality:dts-typechecks": "node tools/check-dts-typechecks.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@biomejs/biome": "^2.4.0",
    "@changesets/cli": "^2.31.0",
    "@ls-lint/ls-lint": "2.3.1",
    "@stryker-mutator/core": "10",
    "@stryker-mutator/vitest-runner": "10",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^4.1.8",
    "dependency-cruiser": "^16.10.0",
    "jscpd": "^4.0.5",
    "knip": "^5.39.0",
    "madge": "8.0.0",
    "publint": "^0.3.20",
    "tsup": "^8.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.8"
  },
  "pnpm": {
    "overrides": {
      "zod": "^4.0.0",
      "vite": "^7.3.6",
      "brace-expansion": "^5.0.9",
      "postcss": "^8.5.25",
      "fast-uri": "^3.1.5",
      "axios": "^1.19.0",
      "form-data": "^4.0.6",
      "linkify-it": "^5.0.2",
      "markdown-it": "^14.3.0",
      "esbuild": "^0.28.1",
      "undici": "^6.23.0",
      "uuid": "^11.1.1",
      "@hono/node-server": "^2.0.5",
      "js-yaml@3": "^3.15.1",
      "js-yaml@4": "^4.3.1",
      "nanoid@<3.3.18": ">=3.3.18",
      "qs@>=6.11.1 <=6.15.1": ">=6.15.2"
    }
  }
}
