{
  "name": "@usetheo/gateway-email",
  "version": "0.1.0",
  "description": "Email platform adapter for @usetheo/gateway. Community-standard 2026 stack: nodemailer + imapflow + mailparser. ADRs D327-D339.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@usetheo/gateway": "workspace:^",
    "@usetheo/sdk": "workspace:^",
    "nodemailer": "^8.0.0",
    "imapflow": "^1.0.0",
    "mailparser": "^3.0.0"
  },
  "devDependencies": {
    "@usetheo/gateway": "workspace:*",
    "@usetheo/sdk": "workspace:*",
    "@types/nodemailer": "^8.0.0",
    "@types/mailparser": "^3.4.0",
    "imapflow": "^1.3.0",
    "mailparser": "^3.9.0",
    "nodemailer": "^8.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
