{
  "name": "@theokit/sdk-cache",
  "version": "0.3.2",
  "description": "Semantic LLM response cache for @theokit/sdk — vector + FTS hybrid lookup, in-memory + JSON file stores, plugin integration.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/usetheodev/theokit-sdk#readme",
  "bugs": "https://github.com/usetheodev/theokit-sdk/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usetheodev/theokit-sdk.git",
    "directory": "packages/sdk-cache"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "node ../../scripts/check-publish-no-workspace.mjs ."
  },
  "peerDependencies": {
    "@theokit/sdk": ">=4.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.8",
    "@theokit/sdk": "workspace:*",
    "zod": "^4.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
