{
  "name": "@usetheo/di-agent",
  "version": "0.1.0-next.0",
  "description": "Agent-first DI integration for @usetheo/di. Ships @InjectAgent() decorator + createAgentProvider() helper that produces a REQUEST-scoped Agent factory — so every HTTP request gets an isolated @usetheo/sdk Agent automatically.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/usetheo/theokit-sdk#readme",
  "bugs": "https://github.com/usetheo/theokit-sdk/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usetheo/theokit-sdk.git",
    "directory": "packages/di-agent"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests"
  },
  "keywords": [
    "dependency-injection",
    "di",
    "agent",
    "theokit",
    "usetheo"
  ],
  "peerDependencies": {
    "@usetheo/di": "^0.1.0-next.0",
    "@usetheo/sdk": "^1.3.0",
    "reflect-metadata": "^0.2.0"
  },
  "devDependencies": {
    "@swc/core": "^1.15.40",
    "@usetheo/di": "workspace:*",
    "@usetheo/sdk": "workspace:*",
    "reflect-metadata": "^0.2.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.0",
    "unplugin-swc": "^1.5.9",
    "vitest": "^3.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
