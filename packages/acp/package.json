{
  "name": "@theokit/acp",
  "version": "3.0.2",
  "description": "Agent Client Protocol (ACP) server adapter for @theokit/sdk. Exposes an SDKAgent over stdio JSON-RPC so Zed/Cursor/Claude Desktop can drive it. ADRs D349-D360.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "bin": {
    "theokit-acp": "./bin/theokit-acp.mjs"
  },
  "files": [
    "dist",
    "bin",
    "registry",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "node ../../scripts/check-publish-no-workspace.mjs ."
  },
  "peerDependencies": {
    "@agentclientprotocol/sdk": "^0.22.1",
    "@theokit/sdk": "workspace:^"
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "~0.22.1",
    "@theokit/sdk": "workspace:*",
    "tsup": "^8.5.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.8"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usetheodev/theokit-sdk.git",
    "directory": "packages/acp"
  }
}
