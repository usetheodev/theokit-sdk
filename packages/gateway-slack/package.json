{
  "name": "@theokit/gateway-slack",
  "version": "0.1.0",
  "description": "Slack (@slack/bolt) platform adapter for @theokit/gateway. ADRs D267-D285.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@theokit/gateway": "workspace:^",
    "@theokit/sdk": "workspace:^",
    "@slack/bolt": "^3.20.0"
  },
  "devDependencies": {
    "@theokit/gateway": "workspace:*",
    "@theokit/sdk": "workspace:*",
    "@slack/bolt": "^3.20.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
