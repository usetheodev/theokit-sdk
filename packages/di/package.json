{
  "name": "@theokit/di",
  "version": "0.1.1",
  "description": "Lightweight TypeScript dependency injection container for the theokit ecosystem (foundation for @theokit/orm + @theokit/http-decorators). NestJS-compatible API with @Injectable, @Inject, @Module + 3 scopes (SINGLETON/TRANSIENT/REQUEST) + agent-aware via @theokit/di-agent.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/usetheo/theokit-sdk#readme",
  "bugs": "https://github.com/usetheo/theokit-sdk/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usetheo/theokit-sdk.git",
    "directory": "packages/di"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests"
  },
  "keywords": [
    "dependency-injection",
    "di",
    "container",
    "decorators",
    "inversion-of-control",
    "ioc",
    "typescript",
    "theokit",
    "Theo"
  ],
  "peerDependencies": {
    "reflect-metadata": "^0.2.0"
  },
  "devDependencies": {
    "@swc/core": "^1.15.40",
    "@vitest/coverage-v8": "^4.1.8",
    "reflect-metadata": "^0.2.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.0",
    "unplugin-swc": "^1.5.9",
    "vitest": "^4.1.8"
  },
  "publishConfig": {
    "access": "public"
  }
}
