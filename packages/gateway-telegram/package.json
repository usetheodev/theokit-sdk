{
  "name": "@theokit/gateway-telegram",
  "version": "0.1.0",
  "description": "Telegram (grammy) platform adapter for @theokit/gateway. ADR D171.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@theokit/gateway": "workspace:^",
    "@theokit/sdk": "workspace:^",
    "grammy": "^1.30.0"
  },
  "devDependencies": {
    "@theokit/gateway": "workspace:*",
    "@theokit/sdk": "workspace:*",
    "grammy": "^1.30.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
