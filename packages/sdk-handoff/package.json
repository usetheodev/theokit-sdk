{
  "name": "@theokit/sdk-handoff",
  "version": "0.1.2",
  "description": "Inter-agent dispatch for @theokit/sdk — typed Handoff descriptors, loop protection, plugin-based wiring.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/usetheodev/theokit-sdk#readme",
  "bugs": "https://github.com/usetheodev/theokit-sdk/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usetheodev/theokit-sdk.git",
    "directory": "packages/sdk-handoff"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "internal/tool-injector": [
        "./dist/internal/tool-injector.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./internal/tool-injector": {
      "import": {
        "types": "./dist/internal/tool-injector.d.ts",
        "default": "./dist/internal/tool-injector.js"
      },
      "require": {
        "types": "./dist/internal/tool-injector.d.cts",
        "default": "./dist/internal/tool-injector.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "node ../../tools/check-publish-no-workspace.mjs ."
  },
  "peerDependencies": {
    "@theokit/sdk": ">=4.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^4.1.8",
    "@theokit/sdk": "workspace:*",
    "zod": "^4.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
