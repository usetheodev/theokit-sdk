{
  "name": "@usetheo/gateway-teams",
  "version": "0.1.0",
  "description": "Microsoft Teams platform adapter for @usetheo/gateway. Built on @microsoft/teams.apps v2 SDK. ADRs D315-D326.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@usetheo/gateway": "workspace:^",
    "@usetheo/sdk": "workspace:^",
    "@microsoft/teams.apps": "^2.0.0",
    "@microsoft/teams.api": "^2.0.0"
  },
  "devDependencies": {
    "@usetheo/gateway": "workspace:*",
    "@usetheo/sdk": "workspace:*",
    "@microsoft/teams.apps": "^2.0.0",
    "@microsoft/teams.api": "^2.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
