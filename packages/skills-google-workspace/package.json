{
  "name": "@usetheo/skills-google-workspace",
  "version": "0.1.0",
  "description": "Google Workspace skill bundle for @usetheo/sdk — single factory that wires the combined `google-workspace-mcp` server (Calendar + Drive + Sheets + Docs + Gmail + Slides + Forms) into Agent.create({ mcpServers }) with read-only-by-default. ADRs D340-D348.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@usetheo/sdk": "workspace:^"
  },
  "devDependencies": {
    "@usetheo/sdk": "workspace:*",
    "tsup": "^8.5.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
