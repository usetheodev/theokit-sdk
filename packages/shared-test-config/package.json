{
  "name": "@theokit/shared-test-config",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./vitest": "./dist/vitest.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/vitest.ts --format esm,cjs --dts",
    "dev": "tsup src/index.ts src/vitest.ts --format esm,cjs --dts --watch"
  },
  "devDependencies": {
    "tsup": "^4.0.0",
    "typescript": "^5.9.3",
    "vitest": "^2.0.0"
  }
}
