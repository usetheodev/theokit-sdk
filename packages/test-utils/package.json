{
  "name": "@theokit/test-utils",
  "version": "1.0.0",
  "description": "Shared test utilities, fixtures, and mocks for Theo packages",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./fixtures": {
      "import": {
        "types": "./dist/fixtures/index.d.ts",
        "default": "./dist/fixtures/index.js"
      }
    },
    "./mocks": {
      "import": {
        "types": "./dist/mocks/index.d.ts",
        "default": "./dist/mocks/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest"
  },
  "dependencies": {
    "@theokit/sdk": "workspace:*"
  },
  "devDependencies": {
    "tsup": "workspace:*",
    "vitest": "workspace:*"
  }
}
