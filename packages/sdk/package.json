  "files": [
    "dist",
    "bin",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "bin": {
    "theokit-migrate-config": "./bin/theokit-migrate-config.mjs",
    "theokit-migrate-memory": "./bin/theokit-migrate-memory.mjs"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run --no-file-parallelism",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "docs:json": "typedoc --options typedoc.json",
    "docs:drift": "tsx scripts/check-docs-drift.ts"
  },
  "peerDependencies": {
    "@lancedb/lancedb": "^0.30.0",
    "@types/ws": ">=8.0.0",
    "better-sqlite3": "^12.0.0",
    "proper-lockfile": "^4.1.2",
    "sqlite-vec": "^0.1.0",
    "ws": ">=8.0.0",
    "zod": "^3.25.0 || ^4.0.0",
    "zod-to-json-schema": "^3.24.0"
  },
  "peerDependenciesMeta": {
    "@lancedb/lancedb": {
      "optional": true
    },
    "@types/ws": {
      "optional": true
    },
    "better-sqlite3": {
      "optional": true
    },
    "proper-lockfile": {
      "optional": true
    },
    "sqlite-vec": {
      "optional": true
    },
    "ws": {
      "optional": true
    },
    "zod-to-json-schema": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "agent",
    "agent-harness",
    "agent-sdk",
    "ai",
    "anthropic",
    "claude",
    "llm",
    "mcp",
    "openai",
    "sdk",
    "theo",
    "theokit",
    "Theo"
  ],
  "dependencies": {
    "croner": "^9.0.0"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-metrics": "^1.30.1",
    "@opentelemetry/sdk-trace-base": "^1.30.1",
    "@theokit/sdk-memory": "workspace:*",
    "@types/better-sqlite3": "^7.6.13",
    "@types/proper-lockfile": "^4.1.4",
    "@types/ws": "^8.18.0",
    "better-sqlite3": "^12.10.0",
    "fast-check": "^4.8.0",
    "proper-lockfile": "^4.1.2",
    "sqlite-vec": "^0.1.9",
    "typedoc": "^0.28.19",
    "ws": "^8.18.0",
    "zod": "^4.0.0"
  }
}
