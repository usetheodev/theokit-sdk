{
  "name": "@usetheo/sdk",
  "version": "1.0.0",
  "description": "TypeScript SDK for the Theo agent harness — same surface, local or cloud.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/usetheo/theokit-sdk#readme",
  "bugs": "https://github.com/usetheo/theokit-sdk/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usetheo/theokit-sdk.git",
    "directory": "packages/sdk"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./cron": {
      "import": {
        "types": "./dist/cron.d.ts",
        "default": "./dist/cron.js"
      },
      "require": {
        "types": "./dist/cron.d.cts",
        "default": "./dist/cron.cjs"
      }
    },
    "./errors": {
      "import": {
        "types": "./dist/errors.d.ts",
        "default": "./dist/errors.js"
      },
      "require": {
        "types": "./dist/errors.d.cts",
        "default": "./dist/errors.cjs"
      }
    },
    "./tools": {
      "import": {
        "types": "./dist/tools/index.d.ts",
        "default": "./dist/tools.js"
      },
      "require": {
        "types": "./dist/tools/index.d.ts",
        "default": "./dist/tools.cjs"
      }
    },
    "./path-safety": {
      "import": {
        "types": "./dist/path-safety.d.ts",
        "default": "./dist/path-safety.js"
      },
      "require": {
        "types": "./dist/path-safety.d.ts",
        "default": "./dist/path-safety.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "bin": {
    "theokit-migrate-config": "./bin/theokit-migrate-config.mjs",
    "theokit-migrate-memory": "./bin/theokit-migrate-memory.mjs"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "docs:json": "typedoc --options typedoc.json",
    "docs:drift": "tsx scripts/check-docs-drift.ts"
  },
  "peerDependencies": {
    "better-sqlite3": "^12.0.0",
    "proper-lockfile": "^4.1.2",
    "sqlite-vec": "^0.1.0",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": true
    },
    "proper-lockfile": {
      "optional": true
    },
    "sqlite-vec": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "agent",
    "agent-harness",
    "agent-sdk",
    "ai",
    "anthropic",
    "claude",
    "llm",
    "mcp",
    "openai",
    "sdk",
    "theo",
    "theokit",
    "usetheo"
  ],
  "dependencies": {
    "croner": "^9.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/proper-lockfile": "^4.1.4",
    "better-sqlite3": "^12.10.0",
    "fast-check": "^4.8.0",
    "proper-lockfile": "^4.1.2",
    "sqlite-vec": "^0.1.9",
    "typedoc": "^0.28.19",
    "zod": "^4.0.0"
  }
}
