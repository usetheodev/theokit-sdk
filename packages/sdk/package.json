      },
      "require": {
        "types": "./dist/errors.d.cts",
        "default": "./dist/errors.cjs"
      }
    },
    "./path-safety": {
      "import": {
        "types": "./dist/path-safety.d.ts",
        "default": "./dist/path-safety.js"
