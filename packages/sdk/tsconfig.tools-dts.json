{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": false,
    "skipLibCheck": true
  },
  "include": ["src/**/*"],
  "exclude": ["src/index.ts", "src/errors.ts", "src/cron.ts", "src/server/auth/**"]
}
