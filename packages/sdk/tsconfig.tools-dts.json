{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": false,
    "skipLibCheck": true
  },
  "include": [
    "src/path-safety.ts",
    "src/concurrency.ts",
    "src/internal/runtime/concurrency/**/*",
    "src/retry.ts",
    "src/internal/runtime/retry/**/*",
    "src/task-store.ts",
    "src/internal/task/store.ts",
    "src/internal/persistence/**/*",
    "src/internal/plugins/**/*",
    "src/internal/observability/**/*",
    "src/internal/security/**/*",
    "src/errors.ts",
    "src/agent.ts",
    "src/agent-factory.ts",
    "src/agent-builder.ts",
    "src/define-tool.ts",
    "src/types/**/*",
    "src/workflow.ts",
    "src/eval.ts",
    "src/scorers.ts",
    "src/internal/eval/**/*",
    "src/internal/workflow/**/*",
    "src/subscription/**/*",
    "src/a2a/**/*",
    "src/client/**/*",
    "src/sandbox/**/*",
    "src/server/**/*",
    "src/event-bus.ts",
    "src/job-queue.ts",
    "src/permission-engine.ts"
  ]
}
