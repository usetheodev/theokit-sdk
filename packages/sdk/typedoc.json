{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": [
    "src/index.ts",
    "src/errors.ts",
    "src/cron.ts",
    "src/messages.ts",
    "src/compaction.ts",
    "src/models.ts",
    "src/skills.ts",
    "src/project.ts",
    "src/subagents.ts",
    "src/path-safety.ts",
    "src/concurrency.ts",
    "src/retry.ts",
    "src/persistence.ts",
    "src/task-store.ts",
    "src/workflow.ts",
    "src/eval.ts",
    "src/server/auth/index.ts",
    "src/server/errors-envelope.ts",
    "src/subscription/index.ts",
    "src/sanitize/index.ts",
    "src/a2a/index.ts",
    "src/client/index.ts",
    "src/sandbox/index.ts",
    "src/filesystem/index.ts"
  ],
  "out": "docs-json",
  "json": "docs-json/api.json",
  "excludePrivate": true,
  "excludeInternal": true,
  "excludeProtected": false,
  "readme": "none",
  "skipErrorChecking": true,
  "tsconfig": "tsconfig.json"
}
