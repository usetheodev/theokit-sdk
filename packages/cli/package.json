{
  "name": "@theokit/cli",
  "version": "3.0.2",
  "description": "Developer CLI for @theokit/sdk — init, dev, inspect, eval. Adoption Roadmap #1.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "theokit": "./dist/bin/theokit.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "node ../../scripts/check-publish-no-workspace.mjs ."
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@theokit/sdk": "workspace:^",
    "commander": "^12.1.0",
    "picocolors": "^1.0.0",
    "tsx": "^4.19.0",
    "zod": "^4.0.0"
  },
  "peerDependencies": {
    "@theokit/acp": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@theokit/acp": {
      "optional": true
    }
  },
  "devDependencies": {
    "@theokit/acp": "workspace:*",
    "@types/node": "^22.10.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.8"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usetheodev/theokit-sdk.git",
    "directory": "packages/cli"
  }
}
