# Local Ollama — zero remote API keys required. Just run `ollama serve`
# and `ollama pull llama3.2:3b` once.
#
# Optional overrides:

# THEOKIT_API_KEY — any non-empty string (used only for cloud catalog
# reads, NOT for local Ollama calls). Default: "local".
THEOKIT_API_KEY=local

# OLLAMA_HOST — base URL of the Ollama server. Defaults to localhost.
# Set this to point at a remote Ollama box.
# OLLAMA_HOST=http://192.168.1.50:11434

# OLLAMA_MODEL — which model to use. Default: ollama/llama3.2:3b
# Pull others with: ollama pull qwen2.5:7b
# OLLAMA_MODEL=ollama/qwen2.5:7b
