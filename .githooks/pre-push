#!/usr/bin/env bash
# pre-push hook — full Tier 1 quality gates (pnpm validate).
# See .claude/quality-gates.md.

set -e

# CI skip: this is a DEVELOPER push-protection hook. In CI (e.g. the changesets
# release action's internal `git push` of the Version PR branch/tags), the
# workflow runs its own explicit gates (`pnpm build`) — re-running the full
# `pnpm validate` here is redundant AND blocks the release when the aggregate
# test suite hits its pre-existing native-binding parallel-contention flakiness.
# core.hooksPath is set by the `prepare` script on every `pnpm install`, so this
# hook is otherwise active inside CI. Dev hooks must not gate CI git operations.
if [ "${CI:-}" = "true" ] || [ -n "${GITHUB_ACTIONS:-}" ]; then
  echo "→ pre-push: CI detected — skipping local dev gate (CI runs its own gates)."
  exit 0
fi

# B-113 — a push that introduces NO new commit has nothing for the gate to validate.
#
# The CI skip above already makes this argument once: a context that adds no code should not re-run
# the suite. A tag pointing at a commit the remote already has is the same case, and it is the push
# that happens during a RELEASE — so the ten minutes are paid at the worst possible moment. Measured
# 2026-08-11: three such pushes in one session, each re-validating a tree the push that carried its
# commits had already validated.
#
# Git feeds ref updates on stdin as `<local-ref> <local-sha> <remote-ref> <remote-sha>`. For each,
# `rev-list <local-sha> --not --remotes=origin` lists the commits origin does not already have. The
# gate is skipped only when that list is empty for EVERY ref in the push.
#
# The failure direction is deliberate, and is the whole reason this is safe: stale remote-tracking
# refs make MORE commits look new, so an out-of-date checkout runs the gate rather than skipping it.
# There is no input that makes an unvalidated commit look already-pushed. A deletion (all-zero local
# sha) carries no tree to validate and is skipped; an empty stdin means git told us nothing, so the
# gate runs.
introduces_new_commits() {
  local _lref lsha _rref _rsha saw_ref=0 verdict=1
  # Read EVERY ref before answering. Returning from inside this loop leaves git
  # writing ref lines into a pipe nobody drains, and git dies of SIGPIPE — exit
  # 141, after the gates have already passed, with nothing pushed and no error
  # message to explain it. The loop is cheap; the early return was not.
  while read -r _lref lsha _rref _rsha; do
    [ -z "${lsha:-}" ] && continue
    case "$lsha" in
      *[!0]*) ;;        # a real sha — classify below
      *) continue ;;    # all zeros: a deletion
    esac
    saw_ref=1
    if [ -n "$(git rev-list "$lsha" --not --remotes=origin 2>/dev/null | head -1)" ]; then
      verdict=0
    fi
  done
  [ "$saw_ref" -eq 1 ] || verdict=0
  return "$verdict"
}

if ! introduces_new_commits; then
  echo "→ pre-push: no new commits in this push (tag, or a ref origin already has) — gate not re-run."
  echo "  Those commits were validated by the push that carried them."
  exit 0
fi

if [ -s "$HOME/.nvm/nvm.sh" ]; then
  # shellcheck source=/dev/null
  . "$HOME/.nvm/nvm.sh" >/dev/null 2>&1 || true
  nvm use --silent >/dev/null 2>&1 || true
fi

# Node 22.12+ gate (ADR D1) — SDK is validated only in its declared engine.
node_version="$(node --version 2>/dev/null || echo "v0.0.0")"
node_major="$(echo "$node_version" | sed -E 's/^v([0-9]+)\..*/\1/')"
if [ "${node_major:-0}" -lt 22 ]; then
  echo "✗ pre-push: Node ${node_version} detected, but >=v22.12.0 is required (see .nvmrc + ADR D1)."
  echo "  Run: nvm use   (respects .nvmrc)"
  exit 1
fi

echo "→ pre-push: pnpm validate (full quality gates, ~30-60s)"
echo ""

# Skip env-gated live LLM integration tests in pre-push. They require
# `ollama serve` + specific models pulled, and even when available are
# slow (60-120s each) and prone to system-load timeouts. Run them
# explicitly via `pnpm --filter=@theokit/sdk exec vitest run tests/integration/`
# when you need to validate the Ollama path.
export SKIP_OLLAMA_E2E="${SKIP_OLLAMA_E2E:-1}"

if ! pnpm -w run validate; then
  echo ""
  echo "✗ One or more hard gates failed. See .claude/quality-gates.md."
  echo "  To push anyway (emergencies only): git push --no-verify"
  exit 1
fi

echo "✓ pre-push gates passed"
