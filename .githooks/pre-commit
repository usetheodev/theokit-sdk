#!/usr/bin/env bash
# pre-commit hook — light Tier 1 quality gates.
# See .claude/quality-gates.md.

set -eo pipefail

# Load nvm if available so we hit the .nvmrc-pinned Node.
if [ -s "$HOME/.nvm/nvm.sh" ]; then
  # shellcheck source=/dev/null
  . "$HOME/.nvm/nvm.sh" >/dev/null 2>&1 || true
  nvm use --silent >/dev/null 2>&1 || true
fi

echo "→ pre-commit: secret scan + Biome check + typecheck"

# G0 — secret scanning. First because it is the only gate whose failure cannot be
# repaired after the fact: Biome and type errors are fixed by another commit, but a
# credential written to the history has to be rotated at the provider. It also runs in
# CI (.github/workflows/secret-scan.yml), which --no-verify cannot skip.
"$(git rev-parse --show-toplevel)/.githooks/secret-scan.sh"

if ! pnpm exec biome check --no-errors-on-unmatched --staged 2>&1; then
  echo ""
  echo "✗ G2 (Biome) failed. Run 'pnpm check:fix' to auto-fix, or fix manually."
  exit 1
fi

# The output is captured rather than piped. `... | tail -3` returns tail's status, so
# without pipefail the `if !` could never be true and this gate always passed — it ran
# build+typecheck for the whole monorepo on every commit to produce a verdict that was
# green by construction. Capturing also means a real failure prints the type errors
# instead of the last three lines of turbo's summary.
if ! typecheck_out=$(pnpm -w run typecheck 2>&1); then
  echo ""
  echo "$typecheck_out" | tail -30
  echo ""
  echo "✗ G1 (typecheck) failed. Fix the types."
  exit 1
fi

echo "✓ pre-commit gates passed"
